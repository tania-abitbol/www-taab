rules_version = '2';

// Complete rule set for the website project (taab-b82a4): deploying this file
// replaces all live rules, and anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // Public, create-only. Applicants can never read, list, update or delete
    // applications; reviews happen through the console / Admin SDK only.
    match /creatorApplications/{applicationId} {
      allow read, update, delete: if false;
      allow create: if isValidCreatorApplication(request.resource.data);
    }

    function isBoundedString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isTikTokUrl(value) {
      return value is string
        && value.size() <= 300
        && value.matches('^https://([a-z]+[.])?tiktok[.]com/.+$');
    }

    // Keep enums and limits in sync with src/config/creatorApplication.ts.
    // Required keys are the current short form. Optional keys are what earlier
    // versions of the page still send; they are checked only when present so
    // both the new payload and cached clients stay valid.
    function isValidCreatorApplication(data) {
      let requiredKeys = [
        'name', 'email', 'country', 'ageConfirmed',
        'tiktokUsername', 'tiktokUrl', 'followers',
        'informationConfirmed', 'status', 'source', 'locale', 'createdAt'
      ];
      let optionalKeys = [
        'state', 'averageViews', 'postingFrequency', 'contentCategories',
        'whyCreator', 'videoUrls', 'contentDifference'
      ];
      let videoUrls = data.get('videoUrls', []);
      return data.keys().hasOnly(requiredKeys.concat(optionalKeys))
        && data.keys().hasAll(requiredKeys)
        && isBoundedString(data.name, 1, 100)
        && isBoundedString(data.email, 3, 254)
        && data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && data.country is string
        && data.country.matches('^[A-Z]{2}$')
        && data.ageConfirmed == true
        && data.tiktokUsername is string
        && data.tiktokUsername.matches('^[A-Za-z0-9._]{2,24}$')
        && isTikTokUrl(data.tiktokUrl)
        && data.followers in ['under_1k', '1k_10k', '10k_50k', '50k_100k', '100k_500k', '500k_plus']
        && (!('state' in data) || isBoundedString(data.state, 1, 100))
        && (!('averageViews' in data) || data.averageViews in ['under_500', '500_2k', '2k_10k', '10k_50k', '50k_plus'])
        && (!('postingFrequency' in data) || data.postingFrequency in ['daily', 'few_per_week', 'weekly', 'few_per_month', 'occasionally'])
        && (!('contentCategories' in data) || (
          data.contentCategories is list
          && data.contentCategories.size() >= 1
          && data.contentCategories.size() <= 4
          && data.contentCategories.hasOnly([
            'comedy', 'storytelling', 'relationships', 'friends', 'lifestyle',
            'pov_skits', 'trends', 'beauty_fashion', 'gaming', 'education',
            'music_dance', 'other'
          ])
        ))
        && videoUrls is list
        && videoUrls.size() <= 3
        && (videoUrls.size() < 1 || isTikTokUrl(videoUrls[0]))
        && (videoUrls.size() < 2 || isTikTokUrl(videoUrls[1]))
        && (videoUrls.size() < 3 || isTikTokUrl(videoUrls[2]))
        && (!('contentDifference' in data) || isBoundedString(data.contentDifference, 10, 500))
        && (!('whyCreator' in data) || isBoundedString(data.whyCreator, 10, 1000))
        && data.informationConfirmed == true
        && data.status == 'new'
        && data.source == 'creators_page'
        && data.locale is string
        && data.locale.matches('^[a-z]{2}(-[A-Z]{2})?$')
        && data.createdAt == request.time;
    }
  }
}
