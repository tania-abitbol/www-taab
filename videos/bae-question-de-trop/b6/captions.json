 },
 {
  "start": 10.142,
  "text": "des deux »…",
  "end": 10.711
 },
 {
  "start": 10.711,
  "text": "c'est lui.",
  "end": 11.558
 },
 {
  "start": 11.558,
  "text": "C'est lui qui",
  "end": 11.988
 },
 {
  "start": 11.988,
  "text": "ment le mieux.",
  "end": 12.87
 },
 {
  "start": 12.87,
  "text": "Le mien a répondu",
  "end": 13.822
 },
 {
  "start": 13.822,
  "text": "quoi, d'après vous ?",
  "end": 14.921
 }
