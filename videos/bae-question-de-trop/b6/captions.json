[
 {
  "start": 0.05,
  "text": "Pose cette question",
  "end": 0.784
 },
 {
  "start": 0.784,
  "text": "à ton mec.",
  "end": 1.62
 },
 {
  "start": 1.62,
  "text": "Qui de nous deux",
  "end": 2.154
 },
 {
  "start": 2.154,
  "text": "ment le mieux ?",
  "end": 2.851
 },
 {
  "start": 2.851,
  "text": "S'il répond « toi »",
  "end": 4.36
 },
 {
  "start": 4.36,
  "text": "direct…",
  "end": 5.231
 },
 {
  "start": 5.231,
  "text": "c'est un homme",
  "end": 5.672
 },
 {
  "start": 5.672,
  "text": "courageux.",
  "end": 6.543
 },
 {
  "start": 6.543,
  "text": "S'il répond « moi »…",
  "end": 7.971
 },
 {
  "start": 7.971,
  "text": "il vient d'avouer.",
  "end": 9.051
 },
 {
  "start": 9.051,
  "text": "Et s'il dit « aucun",
