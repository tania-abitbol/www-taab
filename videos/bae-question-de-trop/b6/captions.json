[
 {
  "start": 0.05,
  "text": "Trois types de mecs",
  "end": 0.749
 },
 {
  "start": 0.749,
  "text": "quand tu lui demandes :",
  "end": 1.806
 },
 {
  "start": 1.806,
  "text": "qui de nous deux",
  "end": 2.328
 },
 {
  "start": 2.328,
  "text": "ment le mieux ?",
  "end": 2.979
 },
 {
  "start": 2.979,
  "text": "Un :",
  "end": 3.397
 },
 {
  "start": 3.397,
  "text": "le politicien.",
  "end": 4.581
 },
 {
  "start": 4.581,
  "text": "« Ça dépend de ce",
  "end": 5.324
 },
 {
  "start": 5.324,
  "text": "qu'on appelle mentir. »",
  "end": 6.763
 },
 {
  "start": 6.763,
  "text": "Deux :",
  "end": 7.193
 },
 {
  "start": 7.193,
  "text": "le fuyard.",
  "end": 8.412
 },
 {
  "start": 8.412,
  "text": "« Attends, j'ai pas",
  "end": 9.213
 },
 {
  "start": 9.213,
  "text": "un truc au four ? »",
  "end": 10.363
 },
 {
  "start": 10.363,
  "text": "Trois :",
  "end": 10.839
 },
 {
  "start": 10.839,
  "text": "le kamikaze.",
  "end": 11.733
 },
 {
  "start": 11.733,
  "text": "« Toi. Évidemment. »",
  "end": 12.975
 },
 {
  "start": 12.975,
  "text": "Le kamikaze dort",
  "end": 13.765
 },
 {
  "start": 13.765,
  "text": "sur le canapé.",
  "end": 14.798
 },
 {
  "start": 14.798,
  "text": "Mais au moins,",
  "end": 15.262
 },
 {
  "start": 15.262,
  "text": "il a pas menti.",
  "end": 16.052
 },
 {
  "start": 16.052,
  "text": "Le tien, c'est lequel ?",
  "end": 17.29
 }
]